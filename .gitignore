cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.so

# Virtual environment
venv/
.venv/

# Testing
.pytest_cache/
.coverage
htmlcov/

# macOS
.DS_Store

# Environment variables
.env
.env.*

# Uploaded documents
data/uploads/*
!data/uploads/.gitkeep

# Vector database
data/vector_store/*
!data/vector_store/.gitkeep

# Logs
*.log
EOF
